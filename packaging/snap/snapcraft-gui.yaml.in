# Rendered by scripts/ci/package_snap.nu (@VERSION@). Repackages the prebuilt release binaries.
name: droidkraft
title: DroidKraft
version: "@VERSION@"
summary: Android device toolkit — stats, logcat, screen mirror, flashing
description: |
  Per-device workspaces with live stats, screen mirroring and recording,
  logcat with fuzzy search, and a native fastboot/ADB flashing toolkit.
  base: core22
grade: stable
confinement: strict
license: MIT

apps:
  droidkraft:
    command: bin/droidkraft
    desktop: usr/share/applications/droidkraft.desktop
    plugs: [home, network, network-bind, raw-usb, x11, wayland, opengl, audio-playback, removable-media]
    environment:
      LD_LIBRARY_PATH: $SNAP/usr/lib/$CRAFT_ARCH_TRIPLET:$LD_LIBRARY_PATH

parts:
  droidkraft:
    plugin: dump
    source: stage
    organize:
      droidkraft: bin/droidkraft
      droidkraft.desktop: usr/share/applications/droidkraft.desktop
      droidkraft.png: usr/share/icons/hicolor/256x256/apps/droidkraft.png
    stage-packages:
      - libxkbcommon0
      - libxkbcommon-x11-0
      - libwayland-client0
      - libvulkan1
      - libx11-xcb1
      - libxcb1
      - libfontconfig1
      - libasound2
      - libdrm2
      - libgbm1
