# Linux-only (no macOS CI runners). Rendered by scripts/ci/render_packaging.nu → copy to your tap (homebrew-tap/Formula/).
class Droidkraft < Formula
  desc "Android device toolkit (desktop app): stats, logcat, mirror, fastboot/ADB flashing"
  homepage "https://github.com/sorinirimies/droidkraft"
  version "@VERSION@"
  license "MIT"

  on_linux do
    on_intel do
      url "https://github.com/sorinirimies/droidkraft/releases/download/v@VERSION@/droidkraft-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_GUI_X86_64@"
    end
  end

  def install
    bin.install "droidkraft"
  end

  test do
    assert_predicate bin/"droidkraft", :exist?
  end
end
