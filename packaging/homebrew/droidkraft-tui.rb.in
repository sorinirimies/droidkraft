# Linux-only (no macOS CI runners). Rendered by scripts/ci/render_packaging.nu → copy to your tap (homebrew-tap/Formula/).
class DroidkraftTui < Formula
  desc "Terminal UI for Android devices: stats, logcat, mirror, fastboot/ADB flashing"
  homepage "https://github.com/sorinirimies/droidkraft"
  version "@VERSION@"
  license "MIT"

  on_linux do
    on_arm do
      url "https://github.com/sorinirimies/droidkraft/releases/download/v@VERSION@/droidkraft-tui-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_AARCH64@"
    end
    on_intel do
      url "https://github.com/sorinirimies/droidkraft/releases/download/v@VERSION@/droidkraft-tui-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA_X86_64@"
    end
  end

  def install
    bin.install "droidkraft-tui"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/droidkraft-tui --version")
  end
end
