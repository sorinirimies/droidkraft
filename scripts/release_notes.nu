# Release-notes builder shared by release_prepare.nu and its tests.

# Markdown body for a GitHub release page.
export def build_release_notes [version: string, cliff_changes: string, last_tag: string]: nothing -> string {
    let changes_header = if ($last_tag | is-empty) {
        "### 🎉 Initial Release"
    } else {
        $"### 📝 Changes since ($last_tag):"
    }
    let repo = "https://github.com/sorinirimies/droidkraft"

    [
        $"# DroidKraft ($version)"
        ""
        "An Android device toolkit in pure Rust — available as a **desktop app (GUI)** and a **terminal UI (TUI)**."
        "Per-device workspaces with live stats, screen mirroring and recording, logcat with fuzzy search, and a native fastboot/ADB flashing toolkit."
        ""
        "## 🚀 What's New"
        ""
        $changes_header
        ""
        $cliff_changes
        ""
        "## 📦 Downloads"
        ""
        "Everything below is attached to this release and built on Linux CI."
        ""
        "| Platform | Format | GUI | TUI |"
        "|---|---|:-:|:-:|"
        "| 🐧 Linux | **AppImage** | ✅ | ✅ |"
        "| 🐧 Linux | **Flatpak** | ✅ | ✅ |"
        "| 🐧 Linux | **Snap** | ✅ | ✅ |"
        "| 🐧 Debian / Ubuntu / Mint | **`.deb`** | ✅ x86_64 | ✅ x86_64 · arm64 |"
        "| 🐧 Fedora / openSUSE / RHEL | **`.rpm`** | ✅ x86_64 | ✅ x86_64 · aarch64 |"
        "| 🐧 Arch | **`PKGBUILD`** (`droidkraft-tui-bin`) | — | ✅ |"
        "| 🐧 Linux | **`.tar.gz`** | ✅ x86_64 | ✅ x86_64 · aarch64 |"
        "| 🪟 Windows | **`.zip`** | — | ✅ x86_64 |"
        "| 🍎 macOS | `cargo install` | ✅ | ✅ |"
        ""
        "The Linux TUI builds target glibc 2.17, so they run on old distros as well."
        ""
        "## 🔧 Install"
        ""
        "```bash"
        "cargo install droidkraft-tui        # terminal UI"
        "cargo install droidkraft            # desktop app"
        "cargo binstall droidkraft-tui       # prebuilt TUI, no compile"
        ""
        "sudo apt install ./droidkraft-tui_*.deb      # Debian / Ubuntu"
        "sudo dnf install ./droidkraft-tui-*.rpm      # Fedora / openSUSE"
        "flatpak install --user droidkraft-*.flatpak  # any distro"
        "sudo snap install --dangerous droidkraft_*.snap && sudo snap connect droidkraft:raw-usb"
        "chmod +x droidkraft-*.AppImage && ./droidkraft-*.AppImage"
        "```"
        ""
        $"Arch: download `PKGBUILD` from this release and run `makepkg -si`. Nix: `nix run github:sorinirimies/droidkraft`."
        ""
        "## 🚀 Quick Start"
        ""
        "```bash"
        "droidkraft-tui     # terminal UI — j/k or arrows to move, Enter to open, q to quit"
        "droidkraft         # desktop app"
        "```"
        ""
        "## 📋 Requirements"
        ""
        "- A device with USB debugging enabled (fastboot needs a udev rule on Linux)"
        "- A running ADB server (`adb start-server`); all traffic uses a pure-Rust ADB client"
        "- `ffmpeg` on `PATH` for screen mirroring and recording"
        ""
        $"**Full changelog:** ($repo)/blob/main/CHANGELOG.md"
    ] | str join "\n"
}
